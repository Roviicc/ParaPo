# Committed on purpose. Both values are PUBLIC by design:
#   - the project URL is in every request the browser makes
#   - the publishable key ships inside the JS bundle; RLS protects the data
# Nothing secret goes in this file — secrets stay in .env.local (gitignored)
# or in Supabase Edge Function secrets. Cloudflare's build has no env vars
# otherwise, and without these the app throws at startup in production.
VITE_SUPABASE_URL=https://smzwbqxttdyvohuizynl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_OIuXLR4L_4L9nobkc1Vdfw_oGoee3Yt
