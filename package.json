{
  "name": "parapo",
  "version": "0.0.0",
  "description": "Ground-truthed jeepney route data for Metro Manila",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-boundaries.mjs && tsc --noEmit && vite build && node scripts/check-build.mjs",
    "check": "npm run build && npm run test:unit",
    "test:unit": "npm run test:reader && npm run test:mapfile && npm run test:pass && npm run test:data",
    "test:reader": "node --experimental-strip-types scripts/read-all-test.mjs",
    "test:mapfile": "node --experimental-strip-types scripts/map-file-test.mjs",
    "test:pass": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/pass-stretches-test.mjs",
    "test:data": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/map-data-test.mjs",
    "check:data": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/check-map-data.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roviicc/ParaPo.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/Roviicc/ParaPo/issues"
  },
  "homepage": "https://github.com/Roviicc/ParaPo#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "maplibre-gl": "^6.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "private": true
}
