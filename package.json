{
  "name": "parapo",
  "version": "0.0.0",
  "description": "Ground-truthed jeepney route data for Metro Manila",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "node scripts/checks/check-boundaries.mjs && tsc --noEmit && vite build && node scripts/checks/check-build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run build && npm run test:unit",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --import ./scripts/node/ts-resolve.mjs --test \"tests/unit/*-test.mjs\"",
    "check:data": "node --experimental-strip-types --import ./scripts/node/ts-resolve.mjs scripts/checks/check-map-data.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roviicc/ParaPo.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bugs": {
    "url": "https://github.com/Roviicc/ParaPo/issues"
  },
  "homepage": "https://github.com/Roviicc/ParaPo#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "maplibre-gl": "^6.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@maplibre/maplibre-gl-style-spec": "^26.4.1",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "private": true,
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
