# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.

VITE_SUPABASE_URL=https://smzwbqxttdyvohuizynl.supabase.co

# Settings -> API Keys -> Publishable key (sb_publishable_...)
# Safe in the browser: RLS is what protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=

# NOTE: the Supabase secret key (sb_secret_...) and the OpenRouteService key
# do NOT belong here. They are set as Edge Function secrets in the Supabase
# dashboard at M1, and never reach the browser bundle.
